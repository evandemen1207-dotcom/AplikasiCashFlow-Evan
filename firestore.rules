rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) && isValidId(transactionId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId) && isValidId(settingId);
      }

      match /ai_insights/{insightId} {
        allow read, write: if isOwner(userId) && isValidId(insightId);
      }
    }
  }
}
